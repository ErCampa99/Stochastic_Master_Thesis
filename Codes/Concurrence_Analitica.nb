Notebook[{

Cell[CellGroupData[{
Cell["Concurrence Analitica di una Matrice Densita Parametrica", "Title",ExpressionUUID->"1f33ca98-b8d3-4d41-babf-4c1f375930b4"],

Cell["Notebook minimale e autoconsistente.", "Text",
 CellChangeTimes->{{3.981356201443837*^9, 3.981356206620126*^9}, 
   3.9813677168996983`*^9},ExpressionUUID->"3be03a44-1413-493d-b831-\
325c3d3b8f45"],

Cell[CellGroupData[{

Cell["1) Funzioni generali", "Section",ExpressionUUID->"39910d7b-a73a-44cc-a3f3-f5785a085317"],

Cell["\<\
ClearAll[ConcurrenceWootters, ConcurrenceAnalytical, sigmaY];\
\>", "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"d5f591fe-71c0-47fd-9b33-238756ed4fe5"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.981367747768357*^9, 3.981367749099369*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"8755189d-6ebd-40b1-9873-692345cf795b"],

Cell["sigmaY = {{0, -I}, {I, 0}};", "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"e11bf5ad-c382-4e23-a37f-4f2d504457d2"],

Cell["\<\
ConcurrenceWootters[rho_] := Module[{YY, rhoTilde, ev, lambdas},
  YY = KroneckerProduct[sigmaY, sigmaY];
  rhoTilde = YY . Conjugate[rho] . YY;
  ev = Eigenvalues[rho . rhoTilde];
  lambdas = Reverse@Sort[Re@Sqrt[Chop[ev]]];
  Max[0, lambdas[[1]] - Total[lambdas[[2 ;; 4]]]]
];\
\>", "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"4c284ffb-d18a-4d9b-8331-c225cb6d440d"],

Cell["\<\
ConcurrenceAnalytical[rho_, ass_: True] := \
FullSimplify[ConcurrenceWootters[rho], Assumptions -> ass];\
\>", "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"3701d4cb-b57f-43a6-be19-54137cf99f49"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2) Matrice esempio (come in figura)", "Section",ExpressionUUID->"fedfa9cd-d6ce-4c8d-9164-c2013a4811d3"],

Cell["\<\
rhoExample = 1/2 {{1, 0, 0, -Exp[-2 (1 - eta) gamma t]},
                 {0, 0, 0, 0},
                 {0, 0, 0, 0},
                 {-Exp[-2 (1 - eta) gamma t], 0, 0, 1}};\
\>", "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"dc117851-ffe3-4cd9-9681-ee40899a89a6"],

Cell[CellGroupData[{

Cell["MatrixForm[rhoExample]", "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"3cef0d21-28bb-400a-80e3-dfece049d02d"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      FractionBox["1", "2"], "0", "0", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "eta"}], ")"}], " ", "gamma", " ", "t"}]]}]},
     {"0", "0", "0", "0"},
     {"0", "0", "0", "0"},
     {
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "eta"}], ")"}], " ", "gamma", " ", "t"}]]}], "0", 
      "0", 
      FractionBox["1", "2"]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.9813677588614173`*^9},
 CellLabel->
  "Out[17]//MatrixForm=",ExpressionUUID->"4879755d-cd0e-4579-981a-\
682f1a70bf6f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3) Assunzioni e risultato analitico", "Section",ExpressionUUID->"bd45b433-39e6-43cf-9bfb-9a452580b369"],

Cell["\<\
ass = Element[{gamma, eta, t}, Reals] && gamma > 0 && eta > 0 && t >= 0 && \
eta <= 1;\
\>", "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"b63734a5-9991-4ff3-865a-bddec8dad374"],

Cell[CellGroupData[{

Cell["concExample = ConcurrenceAnalytical[rhoExample, ass]", "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"0c64c7fa-11bc-483c-a866-a26a4bfcb10e"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\[Piecewise]", GridBox[{
       {"1", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "eta"}], ")"}], " ", "gamma", " ", 
           "t"}]], "\[GreaterEqual]", "1"}]},
       {
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "eta"}], ")"}], " ", "gamma", " ", 
          "t"}]], 
        TagBox["True",
         "PiecewiseDefault",
         AutoDelete->True]}
      },
      AllowedDimensions->{2, Automatic},
      Editable->True,
      GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
      GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.84]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}},
      Selectable->True]}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
   GridBoxSpacings->{"Columns" -> {
       Offset[0.27999999999999997`], {
        Offset[0.35]}, 
       Offset[0.27999999999999997`]}, "Rows" -> {
       Offset[0.2], {
        Offset[0.4]}, 
       Offset[0.2]}}],
  "Piecewise",
  DeleteWithContents->True,
  Editable->False,
  SelectWithContents->True,
  Selectable->False,
  StripWrapperBoxes->True]], "Output",
 CellChangeTimes->{3.9813677590053873`*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"4cb9d8b8-f2d3-4cd5-b8a2-f5c310001f74"]
}, Open  ]],

Cell[CellGroupData[{

Cell["TraditionalForm[concExample]", "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"7573438d-4c6a-429d-98bf-4a813377511d"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\[Piecewise]", GridBox[{
        {"1", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"eta", "-", "1"}], ")"}], " ", "gamma", " ", "t"}]], 
          "\[GreaterEqual]", "1"}]},
        {
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"eta", "-", "1"}], ")"}], " ", "gamma", " ", "t"}]], 
         TagBox["True",
          "PiecewiseDefault",
          AutoDelete->True]}
       },
       AllowedDimensions->{2, Automatic},
       Editable->True,
       GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.84]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}},
       Selectable->True]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.35]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
