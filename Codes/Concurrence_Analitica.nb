   "Piecewise",
   DeleteWithContents->True,
   Editable->False,
   SelectWithContents->True,
   Selectable->False,
   StripWrapperBoxes->True], TraditionalForm]], "Output",
 CellChangeTimes->{3.9813677590454493`*^9},
 CellLabel->
  "Out[20]//TraditionalForm=",ExpressionUUID->"c81da7f6-3a39-41ff-81f0-\
a7490cef07d4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4) Uso con una tua rho", "Section",ExpressionUUID->"0922d152-a78d-47fe-b3c5-47a5025f5d73"],

