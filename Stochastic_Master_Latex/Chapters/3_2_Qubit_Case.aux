\@writefile{toc}{\contentsline {section}{\numberline {3.1}Measurement-induced entanglement in the fluorescence scheme}{55}{section.3.1}\protected@file@percent }
\newlabel{sec:lewalle_fluorescence_review}{{3.1}{55}{Measurement-induced entanglement in the fluorescence scheme}{section.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Schematic representation of the measurement setup. Two remote qubits emit into two independent output modes, which are mixed on a balanced beam splitter and then monitored at the two output ports. The relative phases in the two paths are controlled by phase shifters. Different choices of detection at the output, namely photodetection, homodyne, or heterodyne measurement, correspond to different unravellings of the same open-system dynamics. Adapted from Ref.~\blx@tocontentsinit {0}\cite {Lewalle21}.}}{56}{figure.caption.2}\protected@file@percent }
\newlabel{figure_Setup_Jordan}{{3.1}{56}{Schematic representation of the measurement setup. Two remote qubits emit into two independent output modes, which are mixed on a balanced beam splitter and then monitored at the two output ports. The relative phases in the two paths are controlled by phase shifters. Different choices of detection at the output, namely photodetection, homodyne, or heterodyne measurement, correspond to different unravellings of the same open-system dynamics. Adapted from Ref.~\cite {Lewalle21}}{figure.caption.2}{}}
\newlabel{eq:cv_epr_observables}{{3.4}{57}{Measurement-induced entanglement in the fluorescence scheme}{equation.3.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.1}Analyzing photodetection}{57}{subsection.3.1.1}\protected@file@percent }
\newlabel{eq:lewalle_photodetection_avg_concurrence}{{3.6}{58}{Analyzing photodetection}{equation.3.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.2}Optimal homodyne phases}{58}{subsection.3.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Ideal photodetection dynamics for two emitters initially prepared in \(\ket {ee}\). In the lower panel, the horizontal axis reports the rescaled time \(t/T_1\), while the vertical axis shows the concurrence \(C\). The solid curve represents the trajectory-averaged concurrence, as given by Eq.~\eqref  {eq:lewalle_photodetection_avg_concurrence}, whereas the vertical colored lines denote the click times for different individual trajectories. The upper panel illustrates the corresponding jump mechanism.}}{59}{figure.caption.3}\protected@file@percent }
\newlabel{figure_photodetection_Jordan}{{3.2}{59}{Ideal photodetection dynamics for two emitters initially prepared in \(\ket {ee}\). In the lower panel, the horizontal axis reports the rescaled time \(t/T_1\), while the vertical axis shows the concurrence \(C\). The solid curve represents the trajectory-averaged concurrence, as given by Eq.~\eqref {eq:lewalle_photodetection_avg_concurrence}, whereas the vertical colored lines denote the click times for different individual trajectories. The upper panel illustrates the corresponding jump mechanism}{figure.caption.3}{}}
\newlabel{eq:lewalle_homodyne_avg_concurrence}{{3.9}{59}{Optimal homodyne phases}{equation.3.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Homodyne entanglement generation starting from \(\ket {ee}\). In both panels, the horizontal axis reports the rescaled time \(t/T_1\), while the vertical axis shows the concurrence \(C\). Left panel: individual diffusive trajectories and corresponding trajectory-averaged concurrence for the optimal homodyne phases. Right panel: average concurrence for different relative phase differences \(\vartheta -\theta \). The maximal entanglement yield is obtained for \(|\vartheta -\theta |=\pi /2\), while deviations from this condition reduce the concurrence by progressively restoring which-path distinguishability.}}{60}{figure.caption.4}\protected@file@percent }
\newlabel{figure_homodyne_Jordan}{{3.3}{60}{Homodyne entanglement generation starting from \(\ket {ee}\). In both panels, the horizontal axis reports the rescaled time \(t/T_1\), while the vertical axis shows the concurrence \(C\). Left panel: individual diffusive trajectories and corresponding trajectory-averaged concurrence for the optimal homodyne phases. Right panel: average concurrence for different relative phase differences \(\vartheta -\theta \). The maximal entanglement yield is obtained for \(|\vartheta -\theta |=\pi /2\), while deviations from this condition reduce the concurrence by progressively restoring which-path distinguishability}{figure.caption.4}{}}
